{
  "expo": {
    "name": "سرآشپز هوشمند",
    "slug": "smart-chef",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "atlas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlas.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "برای افزودن مواد اولیه با صدا به میکروفون نیاز داریم",
        "NSSpeechRecognitionUsageDescription": "برای تشخیص مواد اولیه از صدای شما"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5D50",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.atlas.mobile",
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-dev-client",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "برای افزودن مواد اولیه با صدا به میکروفون نیاز داریم",
          "speechRecognitionPermission": "برای تشخیص مواد اولیه از صدای شما"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "360b02ea-68fb-450d-8a5e-d431a675a4b6"
      }
    },
    "owner": "ahmadrs1"
  }
}
