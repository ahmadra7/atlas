{
  "expo": {
    "name": "سرآشپز هوشمند",
    "slug": "smart-chef",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "atlas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlas.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "برای افزودن مواد اولیه با صدا",
        "NSSpeechRecognitionUsageDescription": "برای تشخیص مواد اولیه از صدای شما"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5D50",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.atlas.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-dev-client",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "برای افزودن مواد اولیه با صدا به میکروفون نیاز داریم",
          "speechRecognitionPermission": "برای تشخیص مواد اولیه از صدای شما"
        }
      ]
    ]
  }
}
