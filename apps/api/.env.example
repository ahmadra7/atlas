# PostgreSQL — required for multi-user / large recipe catalog
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas?schema=public"

# Start local DB:
#   docker compose up -d postgres
# Then:
#   npm run db:migrate -w @atlas/api
#   npm run db:seed -w @atlas/api

JWT_SECRET="dev-change-me-atlas-smart-chef"
JWT_EXPIRES_IN="7d"
PORT=4000
# Local catalog dashboard at http://localhost:3000/admin (not for public hosting)
ADMIN_SECRET="atlas-local-admin"
CORS_ORIGIN="https://ahmad.tail4cb55d.ts.net"
DEMO_USER_EMAIL="ahmad@atlas.local"
DEMO_USER_PASSWORD="atlas-demo"

# Optional: show OTP in API response outside production
# ATLAS_OTP_DEBUG=1

# Same Web OAuth client ID as the web app (used to verify Google access tokens)
# Authorized JS origins + redirect URIs: https://ahmad.tail4cb55d.ts.net and .../auth
GOOGLE_CLIENT_ID=
